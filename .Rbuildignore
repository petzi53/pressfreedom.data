# Development environment
^renv$
^renv\.lock$

# IDE configuration (RStudio project files)
^.*\.Rproj$
^\.Rproj\.user$

# Development and archived code
^dev$
^_archive$
^data-raw$

# Editor/tooling configuration and git hooks (not part of the package)
^\.editorconfig$
^\.githooks$

# macOS Finder custom-icon artifact (untracked, but present locally)
^Icon$

# Project documentation and AI agent files
^AGENTS\.md$
^\.posit$
^\.posit/assistant$
# already covers .posit/assistant/ — ignore if Posit Assistant re-adds that line too

# Intermediate data processing files (Phase B, C; kept in git for reproducibility)
^data/cleaned$
^data/processed$
