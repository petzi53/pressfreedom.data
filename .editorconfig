# EditorConfig for pressfreedom.data
# Ensures consistent file encoding and formatting across editors
# https://editorconfig.org/

root = true

# All R files
[*.{R,Rmd,qmd}]
charset = utf-8
insert_final_newline = true
end_of_line = lf
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# DESCRIPTION, NAMESPACE, and other metadata files
[{DESCRIPTION,NAMESPACE,.Rbuildignore,.gitignore}]
charset = utf-8
insert_final_newline = true
end_of_line = lf

# Markdown and text files
[*.{md,txt,yml,yaml}]
charset = utf-8
insert_final_newline = true
end_of_line = lf
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# JSON files
[*.json]
charset = utf-8
insert_final_newline = true
end_of_line = lf
indent_style = space
indent_size = 2
